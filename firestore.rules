rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isChatParticipant() {
      return signedIn()
        && 'participantIds' in resource.data
        && request.auth.uid in resource.data.participantIds;
    }

    function isCreatingDirectChat() {
      return request.resource.data.participantIds.size() == 2
        && (!('type' in request.resource.data) || request.resource.data.type == 'direct');
    }

    function isCreatingGroupChat() {
      return request.resource.data.type == 'group'
        && request.resource.data.participantIds.size() >= 3
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;
    }

    function isCreatingAsParticipant() {
      return signedIn()
        && 'participantIds' in request.resource.data
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() >= 2
        && (isCreatingDirectChat() || isCreatingGroupChat());
    }

    function canAccessChat(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
      return signedIn() && (
        !('participantIds' in chat) ||
        request.auth.uid in chat.participantIds
      );
    }

    // User profiles — readable by any signed-in user (needed for username search)
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
    }

    // Per-user chat list — readable by any signed-in user (sender must read
    // receiver's doc to update lastMessage when sending a message).
    // Owner may update freely; others may only patch the chats array.
    match /userChats/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (
        request.auth.uid == userId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chats'])
      );
    }

    // Chat threads — participants only (legacy docs without participantIds
    // stay readable/writable by any signed-in user until backfilled)
    match /chats/{chatId} {
      allow read: if signedIn() && (
        !('participantIds' in resource.data) || isChatParticipant()
      );
      allow create: if isCreatingAsParticipant();
      allow update: if signedIn() && (
        !('participantIds' in resource.data) || isChatParticipant()
      );
      allow delete: if isChatParticipant();

      // Messages live in a subcollection (not an array on the chat doc)
      match /messages/{messageId} {
        allow read: if canAccessChat(chatId);
        allow create: if canAccessChat(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.id == messageId
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && request.resource.data.keys().hasAll(['id', 'senderId', 'text', 'createdAt'])
          && request.resource.data.keys().hasOnly(['id', 'senderId', 'text', 'createdAt', 'img', 'audio', 'audioDuration', 'call'])
          && (
            !('img' in request.resource.data) ||
            (
              request.resource.data.img is string
              && request.resource.data.img.size() > 0
              && request.resource.data.img.size() <= 4096
            )
          )
          && (
            !('audio' in request.resource.data) ||
            (
              request.resource.data.audio is string
              && request.resource.data.audio.size() > 0
              && request.resource.data.audio.size() <= 4096
            )
          )
          && (
            !('audioDuration' in request.resource.data) ||
            (
              request.resource.data.audioDuration is number
              && request.resource.data.audioDuration >= 0
              && request.resource.data.audioDuration <= 600
            )
          )
          && (
            !('call' in request.resource.data) ||
            (
              request.resource.data.call.keys().hasAll(['type', 'status', 'callId'])
              && request.resource.data.call.keys().hasOnly(['type', 'status', 'callId', 'durationSec'])
              && request.resource.data.call.type in ['voice', 'video']
              && request.resource.data.call.status in ['ended', 'declined', 'missed']
              && request.resource.data.call.callId is string
              && request.resource.data.call.callId == messageId
              && (
                !('durationSec' in request.resource.data.call) ||
                (
                  request.resource.data.call.durationSec is number
                  && request.resource.data.call.durationSec >= 0
                  && request.resource.data.call.durationSec <= 86400
                )
              )
            )
          );
        // Soft-delete or text edit: sender only
        allow update: if canAccessChat(chatId)
          && resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.id == resource.data.id
          && (
            (
              request.resource.data.deleted == true
              && request.resource.data.text is string
              && request.resource.data.keys().hasAll(['id', 'senderId', 'text', 'createdAt', 'deleted'])
              && request.resource.data.keys().hasOnly(['id', 'senderId', 'text', 'createdAt', 'deleted', 'img', 'audio', 'audioDuration', 'call'])
            )
            ||
            (
              (!('deleted' in resource.data) || resource.data.deleted != true)
              && !('deleted' in request.resource.data)
              && request.resource.data.edited == true
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 2000
              && request.resource.data.keys().hasAll(['id', 'senderId', 'text', 'createdAt', 'edited'])
              && request.resource.data.keys().hasOnly(['id', 'senderId', 'text', 'createdAt', 'edited', 'editedAt', 'img', 'audio', 'audioDuration', 'call'])
            )
          );
        allow delete: if false;
      }
    }

    // 1:1 WebRTC call signaling (offer/answer + ICE)
    match /calls/{callId} {
      function isCallParticipant() {
        return signedIn() && (
          request.auth.uid == resource.data.callerId ||
          request.auth.uid == resource.data.calleeId
        );
      }

      function isCallParticipantCreate() {
        return signedIn()
          && request.auth.uid == request.resource.data.callerId
          && request.resource.data.callerId is string
          && request.resource.data.calleeId is string
          && request.resource.data.callerId != request.resource.data.calleeId
          && request.resource.data.type in ['voice', 'video']
          && request.resource.data.status == 'ringing';
      }

      allow read: if signedIn() && (
        resource.data.callerId == request.auth.uid ||
        resource.data.calleeId == request.auth.uid
      );
      allow create: if isCallParticipantCreate();
      allow update: if isCallParticipant();
      allow delete: if false;

      match /iceCandidates/{candidateId} {
        function parentCall() {
          return get(/databases/$(database)/documents/calls/$(callId)).data;
        }

        allow read: if signedIn() && (
          request.auth.uid == parentCall().callerId ||
          request.auth.uid == parentCall().calleeId
        );
        allow create: if signedIn()
          && request.resource.data.from == request.auth.uid
          && (
            request.auth.uid == parentCall().callerId ||
            request.auth.uid == parentCall().calleeId
          );
        allow update, delete: if false;
      }
    }
  }
}
