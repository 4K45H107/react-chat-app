{
  "name": "react-chat-app",
  "private": true,
  "version": "1.0.0",
  "description": "Real-time chat with groups and WebRTC voice/video calls, built on React and Firebase",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "VITE_USE_EMULATORS=true vite",
    "emulators": "firebase emulators:start --project demo-reactchat",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-reactchat \"vitest run --config vitest.rules.config.js\"",
    "seed": "node scripts/seed.mjs",
    "seed:emulators": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199 GCLOUD_PROJECT=demo-reactchat node scripts/seed.mjs",
    "test:integration": "firebase emulators:exec --only auth,firestore,storage --project demo-reactchat \"node scripts/seed.mjs && vitest run --config vitest.integration.config.js\"",
    "size": "size-limit"
  },
  "dependencies": {
    "emoji-picker-react": "^4.12.0",
    "firebase": "^11.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-toastify": "^10.0.6",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@size-limit/file": "^14.3.0",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.11.1",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.2",
    "globals": "^15.9.0",
    "size-limit": "^14.3.0",
    "vite": "^5.4.8",
    "vitest": "^4.1.10"
  },
  "size-limit": [
    {
      "name": "First load (login screen)",
      "path": [
        "dist/assets/index-*.js",
        "dist/assets/react-*.js",
        "dist/assets/firebase-core-*.js"
      ],
      "limit": "95 kB",
      "gzip": true
    },
    {
      "name": "Signed-in app (UI code)",
      "path": "dist/assets/SignedInApp-*.js",
      "limit": "30 kB",
      "gzip": true
    },
    {
      "name": "Emoji picker (on first open)",
      "path": "dist/assets/emoji-picker-react*.js",
      "limit": "70 kB",
      "gzip": true
    }
  ]
}
